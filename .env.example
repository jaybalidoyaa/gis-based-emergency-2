# Server (local Express comparison only — production uses Cloudflare Worker + D1)
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173,https://emergency.brigadaonse.org

# Local Mongo (thesis/dev only — NOT production source of truth)
MONGODB_URI=mongodb://127.0.0.1:27017/barangay-dispatch

# JWT (Worker: set via `wrangler secret put JWT_SECRET`)
JWT_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# Maps
MAP_PROVIDER=mapbox
MAPBOX_ACCESS_TOKEN=
VITE_MAP_PROVIDER=mapbox
VITE_MAPBOX_ACCESS_TOKEN=
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=

GPS_STALE_MINUTES=2
UPLOAD_MAX_MB=10

# Optional FCM (push) — never commit real keys
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# Optional Twilio SMS — never send real SMS in tests
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
NOTIFICATION_PROVIDER=mock

# Frontend API (empty in Cloudflare production = same-origin /api)
VITE_API_URL=
VITE_SOCKET_URL=
VITE_APP_VERSION=1.2.0
VITE_DEMO_ACCOUNTS=false
VITE_ENABLE_GUEST_SOS=true

# Ops timezone is Asia/Manila in the client UI (formatters). Worker GPS stale uses GPS_STALE_MINUTES.